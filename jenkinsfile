pipeline {
    agent any

    stages {
        stage('1. Source Control') {
            steps {
                echo 'Checking out source code from GitHub...'
                checkout scm
            }
        }

        stage('2. Build') {
            steps {
                echo 'Building Docker image for NovaPay Core API...'
                sh 'docker build -t novapay-app:${BUILD_NUMBER} .'
            }
        }

        stage('3. SAST (Static Analysis)') {
            steps {
                echo 'Running Static Application Security Testing (SAST)...'
                // Add SonarQube or Node security checks here
            }
        }

        stage('4. Dependency & Container Scanning') {
            steps {
                echo 'Running Trivy container and dependency vulnerability scan...'
                // Example Trivy scan command:
                // sh 'trivy image --severity HIGH,CRITICAL novapay-app:${BUILD_NUMBER}'
            }
        }

        stage('5. DAST (Dynamic Analysis)') {
            steps {
                echo 'Running Dynamic Application Security Testing (DAST)...'
            }
        }

        stage('6. Policy & Compliance Gates') {
            steps {
                echo 'Validating RBI Master Direction and PCI-DSS v4.0 compliance gates...'
            }
        }

        stage('7. Deployment & Verification (Blue-Green/Canary)') {
            steps {
                echo 'Deploying application with zero-downtime routing and automated health checks...'
                sh 'docker-compose up -d'
            }
        }

        stage('8. Zero-Downtime Database Migration') {
            steps {
                echo 'Executing database schema expand-contract migration patterns...'
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully! Zero-downtime deployment verified.'
        }
        failure {
            echo 'Pipeline failed! Triggering automatic rollback to previous stable version.'
        }
    }
}